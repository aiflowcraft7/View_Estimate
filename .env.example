# ViewEstimate configuration.
# Copy this file to .env and fill in what you have. Every service is optional
# locally: anything left blank runs in a stand-in mode (see KEYS.md).

# ---- Core (required in production) -----------------------------------------
APP_URL=http://localhost:3000
APP_NAME=ViewEstimate
# Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it after launch: it encrypts stored CRM credentials.
APP_SECRET=
# Your email(s); these accounts get the /admin console. Comma separated.
ADMIN_EMAILS=
# Protects /api/cron/*. Vercel sends it automatically when set in the project.
CRON_SECRET=

# ---- Database ----------------------------------------------------------------
# Supabase: Project settings > Database > Connection string > "Transaction pooler" (port 6543).
# Blank = embedded local database in .data/pglite (local development only).
DATABASE_URL=

# ---- Google Maps Platform (address autocomplete, roof and house size) ------
# Enable: Places API (New), Solar API, Maps Static API.
GOOGLE_MAPS_SERVER_KEY=
# Optional separate key for the satellite image, restricted to Maps Static API.
GOOGLE_MAPS_STATIC_KEY=
# Hard cap on paid Google calls per day across all businesses.
GOOGLE_DAILY_CALL_BUDGET=3000

# ---- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="ViewEstimate <alerts@yourdomain.com>"
SUPPORT_EMAIL=support@yourdomain.com
# Company name shown in the privacy policy and terms.
LEGAL_ENTITY_NAME=

# ---- SMS lead alerts (Twilio, optional) -------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a phone number in +1 format or a Messaging Service SID (MG...).
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ---- Billing (Paddle Billing) ------------------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# sandbox or production
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_FOUNDING_MONTHLY=

# ---- Bot protection on the quote form (Cloudflare Turnstile, optional) ------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Auth (Clerk) — required in production ----------------------------------
# Application app_3KwbaRZNHJn2KADxdWfC3l3KzqA. Do not run `clerk init` here; use `clerk env pull` after `clerk link --app app_3KwbaRZNHJn2KADxdWfC3l3KzqA`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# ---- Jobber CRM (optional, Pro plan) ----------------------------------------
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# ---- File storage for logos and photos (Supabase Storage) -------------------
# Blank = files kept in the database (fine locally, not for production).
SUPABASE_URL=
# Same project URL as above; publishable anon key for browser + Clerk JWT (Supabase third-party auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ---- Error tracking (Sentry, optional) --------------------------------------
SENTRY_DSN=

# ---- Advanced ---------------------------------------------------------------
# DB_POOL_MAX=5
# DB_AUTO_MIGRATE=true
