{
  "name": "viewestimate",
  "version": "1.0.0",
  "private": true,
  "description": "Instant-quote widget for exterior-cleaning companies",
  "scripts": {
    "dev": "npm run build:widget && next dev",
    "build": "npm run build:widget && next build",
    "start": "next start",
    "build:widget": "esbuild src/widget/loader.ts --bundle --minify --format=iife --target=es2018 --outfile=public/w.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2",
    "react-dom": "19.2",
    "server-only": "^0.0.1",
    "zod": "3.25"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
